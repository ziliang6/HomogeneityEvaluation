 different bird, or different topic?", "features": {"mtld": 62.217331499312245, "punctuation_density": 18.181818181818183, "function_word_density": 37.5, "paragraph_density": 9.090909090909092, "response_length_chars": 569, "readability_flesch_kincaid_grade": 6.265909090909091, "emotion_intensity": 0.4895617961883545, "emphasis_density": 6.818181818181818, "list_density": 1.1363636363636365, "avg_concreteness": 2.9938406976744187, "word_freq": {"avg_zipf_frequency": 5.475568181818182}, "punctuation": {"comma": 3, "period": 3, "dash": 1, "hyphen": 1, "semicolon": 0, "colon": 2, "exclamation": 0, "question": 2, "ellipsis": 0, "paren": 4, "quote": 0}, "pos_dist": {"ADJ": 0.07608695652173914, "ADP": 0.13043478260869565, "ADV": 0.03260869565217391, "AUX": 0.043478260869565216, "CCONJ": 0.021739130434782608, "DET": 0.09782608695652174, "NOUN": 0.30434782608695654, "NUM": 0.043478260869565216, "PART": 0.021739130434782608, "PRON": 0.043478260869565216, "PROPN": 0.05434782608695652, "SCONJ": 0.021739130434782608, "VERB": 0.10869565217391304}, "dep_dist": {"ROOT": 0.08695652173913043, "acl": 0.010869565217391304, "advmod": 0.05434782608695652, "agent": 0.010869565217391304, "amod": 0.07608695652173914, "appos": 0.03260869565217391, "attr": 0.021739130434782608, "aux": 0.03260869565217391, "auxpass": 0.010869565217391304, "cc": 0.021739130434782608, "compound": 0.05434782608695652, "conj": 0.021739130434782608, "dep": 0.010869565217391304, "det": 0.09782608695652174, "dobj": 0.043478260869565216, "nsubj": 0.043478260869565216, "nsubjpass": 0.010869565217391304, "nummod": 0.021739130434782608, "pcomp": 0.010869565217391304, "pobj": 0.13043478260869565, "poss": 0.010869565217391304, "prep": 0.11956521739130435, "xcomp": 0.03260869565217391, "quantmod": 0.021739130434782608, "oprd": 0.010869565217391304}, "function_words": {"profile": {"article": 0.21212121212121213, "preposition": 0.36363636363636365, "cconj": 0.06060606060606061, "sconj": 0.06060606060606061, "pronoun": 0.1212